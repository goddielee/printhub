{
  "name": "printhub",
  "main": "worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "printhub", "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE" }
  ]
}
